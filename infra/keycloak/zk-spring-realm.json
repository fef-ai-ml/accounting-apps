{
  "realm": "zk-spring",
  "enabled": true,
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Everything, including viewing role mappings" },
      { "name": "EDITOR", "description": "Read and change data" },
      { "name": "VIEWER", "description": "Read-only" },
      { "name": "BOOKKEEPER", "description": "Accounting: read and prepare draft entries" },
      { "name": "ACCOUNTANT", "description": "Accounting: post and reverse entries, manage periods" }
    ]
  },
  "clients": [
    {
      "clientId": "zk-shell",
      "name": "ZK shell",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "zk-shell-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email", "organization"],
      "redirectUris": ["http://localhost:8081/*"],
      "webOrigins": ["http://localhost:8081"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8081/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "tenant",
            "addOrganizationId": "true",
            "addOrganizationAttributes": "false",
            "multivalued": "true",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["ADMIN", "default-roles-zk-spring"]
    },
    {
      "username": "editor",
      "enabled": true,
      "email": "editor@example.com",
      "emailVerified": true,
      "firstName": "Eddie",
      "lastName": "Editor",
      "credentials": [{ "type": "password", "value": "editor", "temporary": false }],
      "realmRoles": ["EDITOR", "default-roles-zk-spring"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "emailVerified": true,
      "firstName": "Vera",
      "lastName": "Viewer",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["VIEWER", "default-roles-zk-spring"]
    },
    {
      "username": "acme-admin",
      "enabled": true,
      "email": "admin@acme.example",
      "emailVerified": true,
      "firstName": "Adi",
      "lastName": "Acme",
      "credentials": [{ "type": "password", "value": "acme-admin", "temporary": false }],
      "realmRoles": ["ADMIN", "default-roles-zk-spring"]
    },
    {
      "username": "bookkeeper",
      "enabled": true,
      "email": "bookkeeper@example.com",
      "emailVerified": true,
      "firstName": "Budi",
      "lastName": "Bookkeeper",
      "credentials": [{ "type": "password", "value": "bookkeeper", "temporary": false }],
      "realmRoles": ["BOOKKEEPER", "default-roles-zk-spring"]
    },
    {
      "username": "accountant",
      "enabled": true,
      "email": "accountant@example.com",
      "emailVerified": true,
      "firstName": "Ani",
      "lastName": "Accountant",
      "credentials": [{ "type": "password", "value": "accountant", "temporary": false }],
      "realmRoles": ["ACCOUNTANT", "default-roles-zk-spring"]
    }
  ],
  "organizations": [
    {
      "id": "7f3a0c4e-1b2d-4e5f-8a9b-0c1d2e3f4a5b",
      "name": "Demo Company",
      "alias": "demo",
      "enabled": true,
      "domains": [{ "name": "example.com" }],
      "members": [{ "username": "admin" }, { "username": "editor" }, { "username": "viewer" }, { "username": "bookkeeper" }, { "username": "accountant" }]
    },
    {
      "id": "b2c4e6a8-0d1f-4a3b-9c5d-7e8f9a0b1c2d",
